{
  "name": "record-node",
  "version": "1.0.0-alpha.0",
  "description": "Reference implementation of Record Protocol v1: a spec-conformant peer for distributed audio libraries",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#encoding/*": "./src/encoding/*",
    "#identity/*": "./src/identity/*",
    "#access-control/*": "./src/access-control/*",
    "#entry/*": "./src/entry/*",
    "#oplog/*": "./src/oplog/*",
    "#fabric/*": "./src/fabric/*",
    "#adapter/*": "./src/adapter/*",
    "#replication/*": "./src/replication/*",
    "#ingest/*": "./src/ingest/*",
    "#query-db/*": "./src/query-db/*",
    "#peer/*": "./src/peer/*",
    "#api/*": "./src/api/*",
    "#types/*": "./src/types/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "test": "bun test",
    "test:conformance": "bun test test/conformance",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@helia/utils": "3.0.5",
    "@ipld/dag-cbor": "9.2.6",
    "@ipld/dag-pb": "4.2.0",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "ajv": "8.20.0",
    "blockstore-core": "7.0.1",
    "datastore-core": "12.0.1",
    "express": "5.2.1",
    "express-openapi-validator": "5.6.2",
    "file-type": "22.1.1",
    "helia": "7.1.15",
    "ipfs-unixfs-importer": "17.1.1",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "multiformats": "13.4.0",
    "music-metadata": "11.16.1",
    "swagger-ui-express": "5.0.1",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.2.0",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "neostandard": "0.13.0",
    "typescript": "6.0.3"
  },
  "trustedDependencies": []
}
