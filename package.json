{
  "name": "record-node",
  "version": "1.1.0-alpha.2",
  "description": "Reference implementation of Record Protocol v1: a spec-conformant peer for distributed audio libraries",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "record-node": "./dist/cli.js"
  },
  "imports": {
    "#encoding/*.ts": {
      "bun": "./src/encoding/*.ts",
      "types": "./dist/encoding/*.d.ts",
      "default": "./dist/encoding/*.js"
    },
    "#identity/*.ts": {
      "bun": "./src/identity/*.ts",
      "types": "./dist/identity/*.d.ts",
      "default": "./dist/identity/*.js"
    },
    "#access-control/*.ts": {
      "bun": "./src/access-control/*.ts",
      "types": "./dist/access-control/*.d.ts",
      "default": "./dist/access-control/*.js"
    },
    "#entry/*.ts": {
      "bun": "./src/entry/*.ts",
      "types": "./dist/entry/*.d.ts",
      "default": "./dist/entry/*.js"
    },
    "#oplog/*.ts": {
      "bun": "./src/oplog/*.ts",
      "types": "./dist/oplog/*.d.ts",
      "default": "./dist/oplog/*.js"
    },
    "#fabric/*.ts": {
      "bun": "./src/fabric/*.ts",
      "types": "./dist/fabric/*.d.ts",
      "default": "./dist/fabric/*.js"
    },
    "#adapter/*.ts": {
      "bun": "./src/adapter/*.ts",
      "types": "./dist/adapter/*.d.ts",
      "default": "./dist/adapter/*.js"
    },
    "#replication/*.ts": {
      "bun": "./src/replication/*.ts",
      "types": "./dist/replication/*.d.ts",
      "default": "./dist/replication/*.js"
    },
    "#ingest/*.ts": {
      "bun": "./src/ingest/*.ts",
      "types": "./dist/ingest/*.d.ts",
      "default": "./dist/ingest/*.js"
    },
    "#query-db/*.ts": {
      "bun": "./src/query-db/*.ts",
      "types": "./dist/query-db/*.d.ts",
      "default": "./dist/query-db/*.js"
    },
    "#peer/*.ts": {
      "bun": "./src/peer/*.ts",
      "types": "./dist/peer/*.d.ts",
      "default": "./dist/peer/*.js"
    },
    "#api/*.ts": {
      "bun": "./src/api/*.ts",
      "types": "./dist/api/*.d.ts",
      "default": "./dist/api/*.js"
    },
    "#types/*.ts": {
      "bun": "./src/types/*.ts",
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "#test/*": "./test/*"
  },
  "scripts": {
    "build": "sh cli/build-dist.sh",
    "test": "bun test",
    "test:conformance": "bun test test/conformance",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "check:dist": "sh cli/check-dist.sh",
    "verify": "bun run lint && bun run typecheck && bun run check:dist"
  },
  "dependencies": {
    "@helia/bitswap": "4.0.19",
    "@helia/libp2p": "2.1.4",
    "@helia/utils": "3.0.5",
    "@ipld/dag-cbor": "9.2.6",
    "@ipld/dag-pb": "4.2.0",
    "@libp2p/autonat": "3.0.28",
    "@libp2p/bootstrap": "12.0.32",
    "@libp2p/circuit-relay-v2": "4.2.13",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/dcutr": "3.0.28",
    "@libp2p/gossipsub": "17.1.2",
    "@libp2p/identify": "4.1.14",
    "@libp2p/interface": "3.3.0",
    "@libp2p/kad-dht": "16.4.5",
    "@libp2p/mdns": "12.0.32",
    "@libp2p/noise": "17.0.3",
    "@libp2p/peer-id": "6.0.15",
    "@libp2p/ping": "3.1.13",
    "@libp2p/pnet": "3.0.29",
    "@libp2p/tcp": "11.0.28",
    "@libp2p/upnp-nat": "4.0.28",
    "@libp2p/utils": "7.4.1",
    "@libp2p/yamux": "8.0.3",
    "@multiformats/multiaddr": "13.0.3",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "ajv": "8.20.0",
    "bitboot": "git+https://github.com/tintfoundation/bitboot.git#ee81e28235c188b08dc16f5bf70aa2612bb13cbe",
    "blockstore-core": "7.0.1",
    "blockstore-fs": "4.0.1",
    "datastore-core": "12.0.1",
    "datastore-fs": "12.0.1",
    "express": "5.2.1",
    "express-openapi-validator": "5.6.2",
    "file-type": "22.1.1",
    "helia": "7.1.15",
    "ipfs-unixfs": "13.1.2",
    "ipfs-unixfs-importer": "17.1.1",
    "libp2p": "3.3.11",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "multiformats": "13.4.0",
    "music-metadata": "11.16.1",
    "record-resolver": "git+https://github.com/mistakia/record-resolver.git#94c5daa7676c92f9d497fc68b3f69643785714cc",
    "socks": "2.8.10",
    "swagger-ui-express": "5.0.1",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@libp2p/config": "1.1.37",
    "@libp2p/logger": "6.2.13",
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.2.0",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.1",
    "bittorrent-dht": "11.0.12",
    "eslint": "9.39.5",
    "neostandard": "0.13.0",
    "typescript": "6.0.3"
  },
  "trustedDependencies": []
}
